# track only the UI backup folders; ignore everything else
*
!.gitignore
!.gitattributes
!Interface/
!Interface/AddOns/
!Interface/AddOns/**
!WTF/
!WTF/**

# WoW mirrors every saved variable as a .bak on login; not needed
WTF/**/*.bak

# RaiderIO China database files and addons (not used on EU realms)
Interface/AddOns/RaiderIO/db/*_cn_*
Interface/AddOns/RaiderIO_DB_CN_*/